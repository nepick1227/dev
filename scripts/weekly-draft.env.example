# scripts/weekly-draft.mjs 실행에 필요한 환경변수 예시입니다.
# 실제 값은 .env.local (git에 절대 커밋되지 않음)에 넣어서 사용하세요.
#
# 이 앱은 카카오·네이버·구글 소셜 로그인만 지원해서 비밀번호가 없습니다.
# 대신 nepick.kr에 로그인한 브라우저 개발자도구에서 sb-<project-ref>-auth-token
# 쿠키(또는 localStorage) 값을 열어 그 안의 refresh_token 필드를 꺼내 넣으세요.
# 방문기 주간 담당자 본인 것만 채우면 됩니다 (예: yk 방문기 주간이면 YK_REFRESH_TOKEN만).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
YK_REFRESH_TOKEN=
BR_REFRESH_TOKEN=
